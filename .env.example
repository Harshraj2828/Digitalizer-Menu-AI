# Database Configuration
# Prisma PostgreSQL connection URL (can be a Supabase database url)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digidish?schema=public"

# OpenAI API Configuration
# Optional for local test fallback mode, required for real visual extraction
OPENAI_API_KEY="your-openai-api-key-here"

# Supabase Storage & Client Configuration
# Setup a Supabase project and create a public bucket named 'menus'
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Web App base URL (for API client routing on Mobile)
NEXT_PUBLIC_API_URL="http://localhost:3000"
